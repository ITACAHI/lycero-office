# Lycero Office Desktop — Release Packaging Environment Template
# Copy to `apps/shell/electron-builder.env` ONLY on isolated build runners if needed
# (gitignored; `.githooks/pre-commit` and `check-public-hygiene.mjs` block committing `electron-builder.env`).
# In production CI, inject these exclusively via GitHub Actions Encrypted Secrets.

# ── 1. Update Channel & Telemetry (Optional; omitted on fork/dev builds) ──────
# LYCERO_UPDATE_URL=https://lycero.com/api/v1/office/updates
# LYCERO_FONT_CDN_URL=https://lycero.com/assets/fonts
# LYCERO_GA4_MEASUREMENT_ID=
# LYCERO_GA4_API_SECRET=

# ── 2. Windows Code Signing (Leave unset for unsigned local/dev builds) ───────
# Set LYCERO_WIN_SIGN_MODE=production in Release CI only.
# LYCERO_WIN_SIGN_MODE=production

# Option A: Microsoft Azure Artifact Signing (Trusted Signing)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TRUSTED_SIGNING_DLIB=
# AZURE_TRUSTED_SIGNING_METADATA=

# Option B: DigiCert KeyLocker (Cloud HSM)
# SM_HOST=
# SM_API_KEY=
# SM_CLIENT_CERT_FILE=
# SM_CLIENT_CERT_PASSWORD=
# SM_KEYPAIR_ALIAS=

# Option C: Cloud/CI PFX (SignPath / OV Certificate injected in CI)
# CSC_LINK=
# CSC_KEY_PASSWORD=

# ── 3. macOS Code Signing & Apple Notarization (Release CI only) ──────────────
# CSC_LINK=                  # base64-encoded Developer ID Application .p12
# CSC_KEY_PASSWORD=          # password for the .p12 certificate
# APPLE_ID=                  # Apple Developer email
# APPLE_APP_SPECIFIC_PASSWORD= # xxxx-xxxx-xxxx-xxxx app-specific password
# APPLE_TEAM_ID=             # 10-character Apple Developer Team ID
