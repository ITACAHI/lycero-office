{
  "name": "@lycero/shell",
  "productName": "Lycero Office",
  "version": "2.0.14",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ITACAHI/lycero-office",
  "private": true,
  "description": "Lycero Office: bộ ứng dụng văn phòng thế hệ AI cho Windows, macOS, Linux",
  "main": "out/main/index.js",
  "desktopName": "lycero-office.desktop",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "electron-vite build && electron .",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:win:ia32": "cross-env LYCERO_WIN_IA32=1 BUILD_DIR=release-ia32 electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux"
  },
  "devDependencies": {
    "@lycero/agent-core": "*",
    "@lycero/ai-auth": "*",
    "@lycero/ai-provider": "*",
    "@lycero/ai-search": "*",
    "@lycero/cli": "*",
    "@lycero/docs": "*",
    "@lycero/docx-engine": "*",
    "@lycero/electron-utils": "*",
    "@lycero/i18n": "*",
    "@lycero/pipelines": "*",
    "@lycero/pptx-engine": "*",
    "@lycero/pptx-render": "*",
    "@lycero/sheets": "*",
    "@lycero/slides": "*",
    "@lycero/ui": "*",
    "@lycero/xlsx-gateway": "*",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.8.4",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "officecrypto-tool": "^0.0.19",
    "png-to-icns": "^1.0.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11"
  },
  "author": "ITAC AI Heavy Industries"
}
