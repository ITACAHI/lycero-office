#!/bin/sh
# lycero-office launcher. Inside a packaged Lycero Office it runs the bundled
# CLI on the app's own Node runtime (ELECTRON_RUN_AS_NODE); in a dev checkout
# it falls back to the system node and the local build output. Usually reached
# through a symlink on the PATH, so the real location is resolved first.
self="$0"
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case "$target" in
    /*) self="$target" ;;
    *) self="$(dirname "$self")/$target" ;;
  esac
done
here=$(cd "$(dirname "$self")" && pwd)

if [ -n "$LYCERO_NODE" ]; then
  exec "$LYCERO_NODE" "$here/lycero-office.cjs" "$@"
fi

case "$here" in
  */Contents/Resources/cli) app="$here/../../MacOS/Lycero Office" ;;
  */resources/cli)
    # Linux install, or the Windows install reached from Git Bash / MSYS
    if [ -x "$here/../../Lycero Office.exe" ]; then app="$here/../../Lycero Office.exe"; else app="$here/../../lycero-office"; fi
    ;;
  *) app="" ;;
esac

if [ -n "$app" ] && [ -x "$app" ]; then
  ELECTRON_RUN_AS_NODE=1 exec "$app" "$here/lycero-office.cjs" "$@"
fi

if [ -f "$here/lycero-office.cjs" ]; then
  exec node "$here/lycero-office.cjs" "$@"
fi
exec node "$here/../dist/lycero-office.cjs" "$@"
