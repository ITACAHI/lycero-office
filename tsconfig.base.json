{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@lycero/ai-auth": ["packages/ai-auth/src/index.ts"],
      "@lycero/ai-auth/main": ["packages/ai-auth/src/lycero-auth.ts"]
    }
  }
}
